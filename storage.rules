rules_version = '2';
service firebase.storage {
  match /b/{bucket}/o {
    // All other access is denied — the app uses Cloudflare R2 for object storage,
    // not Firebase Storage. These rules are vestigial and were never updated
    // when the stack was switched to R2.
    match /{allPaths=**} {
      allow read, write: if false;
    }
  }
}
