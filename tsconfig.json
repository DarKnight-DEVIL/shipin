{
  "$schema": "https://json.schemastore.org/tsconfig",
  // Base config only. Every workspace extends this for compilerOptions and
  // declares its own `include`, so nothing here compiles on its own.
  //
  // `files: []` plus `references` makes this a solution-style config: the two
  // workspaces are the projects, and this file only carries the shared
  // compilerOptions they extend. Without the references, `tsc -p .` — and every
  // editor that opens this file — reported TS18002, "The 'files' list in config
  // file is empty".
  //
  // Compiling nothing at the root is deliberate. It used to be
  // `include: ["packages/*/src/**/*"]`, which made a bare `tsc -p .` at the repo
  // root check the packages and exit 0 while silently ignoring apps/web — a
  // green result that proved very little. Widening the include instead is not
  // an option: apps/web needs its own `paths` (@/*), Next's tsconfig plugin and
  // `.next/types`, so a root-wide project would drown in false
  // unresolved-import errors.
  //
  // The project-wide check is `npm run typecheck` → `turbo run typecheck`,
  // which runs `tsc --noEmit` in the two remaining workspaces (config, web);
  // the unused ui/shared/utils packages were removed in the §2.6 orphan
  // cleanup, which is why they are not referenced below. CI runs exactly that.
  // A bare root `tsc -p .` now checks nothing and exits 0, so it is not the
  // gate. `tsc -b` is: it builds both referenced projects — packages/config
  // emits its `dist/` while apps/web stays check-only through `noEmit` — and
  // exits 0. Both its outputs (`dist/`, `*.tsbuildinfo`) are gitignored.
  "files": [],
  "references": [
    { "path": "./packages/config" },
    { "path": "./apps/web" }
  ],
  "compilerOptions": {
    "target": "ES2022",
    "lib": ["dom", "dom.iterable", "esnext"],
    "allowJs": true,
    "skipLibCheck": true,
    "strict": true,
    "noEmit": true,
    "esModuleInterop": true,
    "module": "esnext",
    "moduleResolution": "bundler",
    "resolveJsonModule": true,
    "isolatedModules": true,
    "jsx": "react-jsx",
    "incremental": true,
    // `types` replaces the automatic inclusion of every @types package, and
    // that restriction is the point: without it each workspace would pull the
    // ambient declarations of every dependency in the tree (three, qrcode,
    // testing-library, ...) into code that never loads them. DOM globals do
    // not come from @types at all — they come from `lib` above — so client
    // code is unaffected. An ambient package a workspace does rely on has to
    // be named there: `apps/web` adds `vitest/globals` because its vitest
    // config sets `globals: true`.
    "types": ["node"]
  }
}
