{
  "name": "shipin",
  "version": "0.1.0",
  "private": true,
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "dev": "turbo run dev",
    "build": "turbo run build",
    "start": "npm run start --workspace=@shipin/web",
    "lint": "turbo run lint",
    "typecheck": "turbo run typecheck",
    "test": "turbo run test",
    "test:watch": "npm run test:watch --workspace=@shipin/web",
    "test:coverage": "npm run test:coverage --workspace=@shipin/web",
    "test:shuffle": "npm run test:shuffle --workspace=@shipin/web",
    "test:security": "npm run test:security --workspace=@shipin/web",
    "test:rules": "npm run test:rules --workspace=@shipin/web",
    "test:e2e": "npm run test:e2e --workspace=@shipin/web",
    "check:bundle-budget": "npm run check:bundle-budget --workspace=@shipin/web"
  },
  "devDependencies": {
    "turbo": "^2.5.6"
  },
  "engines": {
    "node": ">=22.12.0"
  },
  "overrides": {
    "@grpc/grpc-js": "^1.14.5",
    "@typescript-eslint/typescript-estree": {
      "minimatch": "^11.0.7"
    },
    "jwks-rsa": {
      "jose": "^4.15.9"
    }
  },
  "packageManager": "npm@12.2.2"
}