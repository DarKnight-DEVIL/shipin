rules_version = '2';

// ShipIN Firestore rules.
//
// Trust boundary: the browser may READ what it is allowed to see and may file
// a brand-new request, but it may never move money, price a request or change
// a request's workflow state. Those writes belong to the Admin SDK routes
// under /api/**, which bypass these rules.
//
// The previous version granted `update` on `request.resource.data.userId`,
// which is the document AFTER the write. Any signed-in customer could therefore
// PATCH their own request to `status: "paid"`, rewrite
// `quote.breakdown.grandTotal`, or PATCH `wallets/{uid}.balance` to any number
// and spend it through /api/payment/complete-wallet.

service cloud.firestore {
  match /databases/{database}/documents {

    function signedIn() {
      return request.auth != null;
    }

    function isSelf(userId) {
      return signedIn() && request.auth.uid == userId;
    }

    // Admin identity is the profile document, not a Firebase custom claim.
    //
    // This used to read `request.auth.token.admin`, and nothing in this
    // repository ever granted that claim: the app's own gate checks
    // `users/{uid}.role`, so a promoted administrator could use /api/admin/**
    // and still be denied every browser-side read or write by these rules.
    // Reading the profile keeps one source of truth, needs no token refresh, and
    // makes a demotion take effect immediately instead of when the ID token
    // expires. `get()` inside rules is a privileged read, so the users/{uid}
    // read rule below does not apply to it.
    function isAdmin() {
      return signedIn()
        && exists(/databases/$(database)/documents/users/$(request.auth.uid))
        && get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'admin';
    }

    // ------------------------------------------------------------------ users
    // A customer owns their profile, but not the fields that grant privilege
    // or move money. Without this split a customer could write `role: "admin"`
    // on their own document, enrol their own MFA, and inherit the console.
    match /users/{userId} {
      allow read: if isSelf(userId);

      allow create: if isSelf(userId)
        && (!('role' in request.resource.data) || request.resource.data.role == 'customer')
        && !('mfa' in request.resource.data);

      allow update: if isSelf(userId)
        && !request.resource.data.diff(resource.data).affectedKeys().hasAny([
             'role',
             'mfa',
             'disabled',
             'suspended',
             'banned',
             'deletedAt',
             'walletBalance',
             'email',
             'emailVerified'
           ]);

      allow delete: if false;
    }

    // --------------------------------------------------------------- requests
    match /requests/{requestId} {
      allow read: if isAdmin() || isSelf(resource.data.userId);

      // Filing a request is the one customer write that stays client-side
      // (see POST /api/requests in the new-request flow). It must be born
      // unpriced, unpaid and unshipped — every later transition runs through
      // /api/requests/[requestId]/* with the Admin SDK.
      allow create: if signedIn()
        && request.resource.data.userId == request.auth.uid
        && request.resource.data.status == 'submitted'
        && !request.resource.data.keys().hasAny([
             'quote',
             'payment',
             'purchases',
             'refundRequests',
             'shipment',
             'tracking',
             'inspection',
             'deliveredAt'
           ]);

      // Customers cannot update a request from the browser at all: no status,
      // no quote, no payment record. Admin console writes keep working.
      allow update: if isAdmin();
      allow delete: if false;
    }

    // --------------------------------------------------------------- shipments
    // Consolidating and shipping a package is admin work; a customer only reads
    // the shipment they own (the /shipment/[id] page).
    //
    // There was no block here at all, so the default deny made every client read
    // of `shipments` fail: the customer shipment page rendered empty and the
    // admin consolidation panel could not list a customer's shipments.
    match /shipments/{shipmentId} {
      allow read: if isAdmin() || isSelf(resource.data.userId);
      allow create, update: if isAdmin();
      allow delete: if false;
    }

    // -------------------------------------------------------------- counters
    // Tracking counter is administered by the Admin SDK; clients must never
    // write to it. The admin UI generates tracking IDs through /api/admin/requests
    // which bypasses these rules, but the browser-side generateTrackingId() function
    // must be blocked from writing counters/tracking to avoid permission-denied errors.
    match /counters/{counterId} {
      allow read: if isAdmin();
      allow write: if false;
      allow create: if false;
    }

    // ----------------------------------------------------------------- wallet
    // Balance is only ever moved by Admin SDK transactions
    // (features/wallet/services/walletPayment.ts, admin/wallet/credit).
    //
    // `getWallet()` still self-provisions an empty wallet on first visit, so
    // creation is allowed for the owner — but only at zero, only once, and the
    // document can never be updated or deleted afterwards.
    match /wallets/{userId} {
      allow read: if isAdmin() || isSelf(userId);

      allow create: if isSelf(userId)
        && request.resource.data.keys().hasOnly(['balance', 'currency'])
        && request.resource.data.balance == 0;

      allow update, delete: if false;
    }

    match /walletTransactions/{transactionId} {
      allow read: if isAdmin() || isSelf(resource.data.userId);
      allow write: if false;
    }

    // Addresses subcollection under user document.
    //
    // The app reads this collection from the client (getAddresses) and writes
    // it only through /api/addresses with the Admin SDK, which bypasses these
    // rules. The old `allow read, write: if isSelf(userId)` therefore granted a
    // capability nothing used: a signed-in customer could write any fields they
    // liked straight into their own subcollection, skipping the route's zod
    // validation and its `isDefault` bookkeeping. Read stays, write is denied.
    match /users/{userId}/addresses {
      allow read: if isSelf(userId);
    }

    match /users/{userId}/addresses/{addressId} {
      allow read: if isSelf(userId);
      allow write: if false;
    }

    match /paypalPaymentOrders/{orderId} {
      allow read: if isAdmin() || isSelf(resource.data.userId);
      allow write: if false;
    }

    // ----------------------------------------------------------------- quotes
    match /quotes/{quoteId} {
      allow read: if isAdmin() || isSelf(resource.data.userId);

      // Pricing is decided by the admin routes; a customer approving a quote
      // writes to the request through /api/requests/[requestId]/approve-quote.
      allow write: if false;
    }

    // There is no `refundRequests` rule block on purpose. The collection has no
    // writer and no reader anywhere in the app — refunds go through
    // /api/admin/requests/[requestId]/refund* with the Admin SDK — and the old
    // block allowed a customer to create a document with any `userId` equal to
    // their own while the rest of the payload (status, amounts) was
    // unconstrained. Default deny is the correct rule for a collection nothing
    // uses; a future writer has to add a rule, which is the point.

    // ----------------------------------------------------------- notifications
    // Read by the bell in the platform shell, which subscribes with
    // `where('userId', '==', uid)`. The equality filter is what lets the rules
    // engine prove this read for a list query — without a match block here the
    // collection fell through to the default deny, and that listener failed
    // with permission-denied on every signed-in page.
    //
    // Created from the browser by the admin request flows (`rejectRequest`
    // and the other request flows in features/requests/services): a customer
    // notifies themselves, an admin notifies the customer whose request
    // changed. `read` must arrive false so a create cannot land pre-read, and
    // nothing is updatable from the client — marking read goes through
    // /api/notifications.
    match /notifications/{notificationId} {
      allow read: if isSelf(resource.data.userId);

      // The browser payload is exactly [userId, requestId, title, message,
      // type, read, createdAt] (features/requests/services/requests.ts). Anything
      // else is rejected: without the allowlist a customer could seed their own
      // bell with fields the bell renders but never expects.
      allow create: if signedIn()
        && (request.resource.data.userId == request.auth.uid || isAdmin())
        && request.resource.data.read == false
        && request.resource.data.type in ['rejection', 'payment', 'quote', 'shipment', 'support']
        && request.resource.data.title is string
        && request.resource.data.message is string
        && request.resource.data.title.size() <= 200
        && request.resource.data.message.size() <= 2000
        && request.resource.data.createdAt == request.time
        && request.resource.data.keys().hasOnly([
             'userId',
             'requestId',
             'title',
             'message',
             'type',
             'read',
             'createdAt'
           ]);

      allow update, delete: if false;
    }

    // ---------------------------------------------------------------- support
    match /supportTickets/{ticketId} {
      allow read: if signedIn() && (
        resource.data.customerId == request.auth.uid ||
        isAdmin()
      );

      // A customer may only clear their own unread flag. Status, priority,
      // assignment, resolution and every other admin-owned field stay
      // admin-only: the previous `allow read, update` let a customer resolve,
      // reassign or rewrite their own ticket with a single client PATCH.
      // `markSupportTicketRead` is the only customer write in the app, and it
      // touches exactly these two keys.
      allow update: if isAdmin() || (
        isSelf(resource.data.customerId)
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly([
             'customerUnread',
             'updatedAt'
           ])
        && request.resource.data.customerUnread == false
      );

      // The customer side of createSupportTicket sends customerId, category,
      // subject, requestId, ticketNumber and the two timestamps. `status` is
      // pinned to "open" (a ticket cannot be born resolved) and nothing else
      // may ride along, so priority/assignment stay admin-owned.
      allow create: if isSelf(request.resource.data.customerId)
        && request.resource.data.status == 'open'
        && request.resource.data.createdAt == request.time
        && request.resource.data.updatedAt == request.time
        && request.resource.data.category in [
             'Shipment',
             'Tracking',
             'Payment',
             'Refund',
             'Customs',
             'Missing Item',
             'Wrong Item',
             'Other'
           ]
        && request.resource.data.keys().hasOnly([
             'ticketNumber',
             'requestId',
             'customerId',
             'category',
             'subject',
             'status',
             'customerUnread',
             'adminUnread',
             'createdAt',
             'updatedAt'
           ]);
      allow delete: if false;
    }

    match /supportMessages/{messageId} {
      // Messages do not carry customerId, so ownership comes from the parent
      // ticket. Use `resource` here, not `request.resource`: on a read there is
      // no proposed document, so `request.resource` is null and reading into it
      // errors — which denies the request, and with it every customer read.
      allow read: if signedIn() && (
        isAdmin()
        || get(/databases/$(database)/documents/supportTickets/$(resource.data.ticketId)).data.customerId == request.auth.uid
      );

      // Messages do not carry customerId on the client (features/support/
      // services writes {ticketId, sender, message, createdAt}), so the old
      // rule rejected every customer message, including the first one sent
      // with a new ticket. Ownership is taken from the parent ticket instead:
      // an admin may reply to any ticket, a customer only to their own, and
      // only as the customer.
      allow create: if signedIn()
        && request.resource.data.createdAt == request.time
        && request.resource.data.message is string
        && request.resource.data.message.size() > 0
        && request.resource.data.message.size() <= 5000
        && request.resource.data.keys().hasOnly([
             'ticketId',
             'sender',
             'message',
             'createdAt'
           ])
        && (
          isAdmin()
          || (
            request.resource.data.sender == 'customer'
            && get(/databases/$(database)/documents/supportTickets/$(request.resource.data.ticketId)).data.customerId == request.auth.uid
          )
        );
      allow update, delete: if false;
    }
  }
}
