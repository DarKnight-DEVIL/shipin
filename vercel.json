{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "buildCommand": "npm run build",
  "outputDirectory": "apps/web/.next/standalone",
  "installCommand": "npm ci",
  "framework": null,
  "devCommand": "npm run dev",
  "regions": ["iad1"],
  "functions": {
    "app/**/*.ts": {
      "maxDuration": 10
    }
  },
  "env": {
    "NEXT_PUBLIC_APP_URL": "@next_public_app_url",
    "PAYPAL_CLIENT_ID": "@paypal_client_id",
    "PAYPAL_CLIENT_SECRET": "@paypal_client_secret",
    "PAYPAL_API_URL": "@paypal_api_url",
    "PAYPAL_ENV": "@paypal_env",
    "RESEND_API_KEY": "@resend_api_key",
    "FIREBASE_ADMIN_PROJECT_ID": "@firebase_admin_project_id",
    "FIREBASE_ADMIN_CLIENT_EMAIL": "@firebase_admin_client_email",
    "FIREBASE_ADMIN_PRIVATE_KEY": "@firebase_admin_private_key",
    "NEXT_PUBLIC_FIREBASE_API_KEY": "@next_public_firebase_api_key",
    "NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN": "@next_public_firebase_auth_domain",
    "NEXT_PUBLIC_FIREBASE_PROJECT_ID": "@next_public_firebase_project_id",
    "NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET": "@next_public_firebase_storage_bucket",
    "NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID": "@next_public_firebase_messaging_sender_id",
    "NEXT_PUBLIC_FIREBASE_APP_ID": "@next_public_firebase_app_id",
    "R2_ACCOUNT_ID": "@r2_account_id",
    "R2_ACCESS_KEY_ID": "@r2_access_key_id",
    "R2_SECRET_ACCESS_KEY": "@r2_secret_access_key",
    "R2_BUCKET_NAME": "@r2_bucket_name",
    "NODE_ENV": "production"
  },
  "crons": [
    {
      "path": "/api/admin/requests/quotes/expire",
      "schedule": "0 * * * *"
    }
  ]
}