{
  "name": "@shipin/web",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "dev": "next dev",
    "build": "next build && node scripts/prepare-standalone.mjs",
    "migrate": "node --env-file-if-exists=.env.local scripts/migrations/migration-runner.ts",
    "prestart": "node scripts/prepare-standalone.mjs",
    "start": "node --experimental-strip-types --env-file-if-exists=.env --env-file-if-exists=.env.local scripts/start-preflight.ts && node --env-file-if-exists=.env --env-file-if-exists=.env.local .next/standalone/apps/web/server.js",
    "lint": "eslint",
    "typecheck": "tsc --noEmit && npm run typecheck:preflight",
    "typecheck:preflight": "tsc --noEmit -p tsconfig.scripts.json",
    "gen:api-routes": "node scripts/generate-api-route-manifest.mjs",
    "gen:api-docs": "node scripts/gen-api-docs.mjs",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:contract": "vitest run --config vitest.contract.config.ts",
    "test:coverage": "node scripts/run-coverage.mjs",
    "test:coverage:components": "vitest run --config vitest.components.config.ts",
    "test:shuffle": "vitest run --sequence.shuffle",
    "test:security": "vitest run src/lib/auth.test.ts src/lib/mfaSession.test.ts src/lib/firestoreRules.test.ts",
    "test:admin": "npx --yes firebase-tools@15.36.0 --config ../../firebase.json emulators:exec --only firestore,auth --project demo-shipin \"vitest run --config vitest.admin.config.ts\"",
    "test:rules": "npx --yes firebase-tools@15.36.0 --config ../../firebase.json emulators:exec --only firestore --project shipin-rules \"vitest run --config vitest.rules.config.ts\"",
    "test:e2e": "playwright test",
    "test:e2e:local": "node scripts/e2e-local.mjs",
    "test:e2e:signed-in": "node scripts/e2e-local.mjs --signed-in",
    "test:e2e:dev": "cross-env PLAYWRIGHT_DEV=1 playwright test",
    "test:e2e:ui": "playwright test --ui",
    "analyze": "cross-env ANALYZE=true next build",
    "check:bundle-budget": "node scripts/check-bundle-budgets.mjs",
    "check:coverage-globs": "node scripts/check-coverage-globs.mjs",
    "check:compliance-tests": "node scripts/check-compliance-tests.mjs",
    "check:money-globs": "node scripts/check-money-globs.mjs",
    "check:authorized-domains": "node scripts/check-authorized-domains.mjs",
    "check:firestore-indexes": "node scripts/check-firestore-indexes.mjs",
    "check:env-inlining": "node scripts/check-env-inlining.mjs",
    "check:production-env": "node --experimental-strip-types scripts/check-production-env.ts",
    "check:licenses": "node scripts/check-licenses.mjs"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "3.1171.0",
    "@aws-sdk/s3-request-presigner": "3.1167.0",
    "@paypal/react-paypal-js": "10.6.1",
    "@react-pdf/renderer": "4.9.0",
    "@sentry/nextjs": "11.12.0",
    "@shipin/config": "*",
    "@simplewebauthn/browser": "14.0.0",
    "@simplewebauthn/server": "14.1.0",
    "@upstash/ratelimit": "2.2.0",
    "@upstash/redis": "1.41.0",
    "@vercel/analytics": "2.0.1",
    "@vercel/speed-insights": "2.1.0",
    "axe-core": "4.14.0",
    "clsx": "2.1.1",
    "date-fns": "4.4.0",
    "firebase": "13.4.0",
    "firebase-admin": "14.5.1",
    "framer-motion": "14.14.0",
    "jspdf": "4.2.1",
    "lenis": "1.3.27",
    "lucide-react": "1.72.0",
    "next": "16.4.6",
    "next-themes": "0.4.6",
    "nodemailer": "10.5.0",
    "otplib": "13.6.0",
    "qrcode": "1.5.4",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "react-phone-number-input": "3.4.18",
    "react-select": "5.10.2",
    "recharts": "3.10.1",
    "resend": "6.38.0",
    "server-only": "0.0.1",
    "sonner": "2.0.8",
    "three": "0.187.0",
    "yet-another-react-lightbox": "3.33.0",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@next/bundle-analyzer": "16.4.6",
    "@playwright/test": "1.65.0",
    "@tailwindcss/postcss": "4.3.5",
    "@testing-library/dom": "10.4.2",
    "@testing-library/jest-dom": "7.0.1",
    "@testing-library/react": "16.3.3",
    "@types/node": "24.19.2",
    "@types/nodemailer": "8.0.2",
    "@types/qrcode": "1.5.6",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@types/three": "0.187.0",
    "@vitejs/plugin-react": "6.3.0",
    "@vitest/coverage-v8": "5.1.0",
    "cross-env": "10.1.0",
    "eslint": "9.39.5",
    "eslint-config-next": "16.4.6",
    "happy-dom": "21.0.4",
    "tailwindcss": "4.3.5",
    "typescript": "7.0.2",
    "vite": "8.3.8",
    "vitest": "5.1.0"
  }
}
