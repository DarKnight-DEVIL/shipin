{
  "extends": "../../tsconfig.json",
  "compilerOptions": {
    "allowJs": true,
    // `vitest.config.ts` sets `globals: true`, so describe/it/expect exist at
    // runtime without an import. The base config deliberately restricts
    // `types` to node, which would leave those globals untyped; name the
    // package here so the type graph matches the runner.
    "types": ["node", "vitest/globals"],
    "plugins": [
      {
        "name": "next"
      }
    ],
    "paths": {
      // Root imports (@/lib/auth) resolve from the app root first, then src.
      "@/*": ["./*", "./src/*"]
    }
  },
  "include": [
    "next-env.d.ts",
    "**/*.ts",
    "**/*.tsx",
    ".next/types/**/*.ts",
    ".next/dev/types/**/*.ts",
    "../../packages/*/src/**/*.ts",
    "../../packages/*/src/**/*.tsx"
  ],
  "exclude": ["node_modules", "scripts"]
}
