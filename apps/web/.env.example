NODE_ENV=development
# =============================================================================
# ShipIN — Environment Template
#
# Copy this file to `.env.local` and fill in real values:
#   cp .env.example .env.local
#
# Variables without a value are REQUIRED for the server to start.
# Client-exposed variables MUST be prefixed with NEXT_PUBLIC_.
# The app validates these at startup via src/config/env (fail-fast).
# =============================================================================

# --- Application ---
# Base URL used in emails / webhook callbacks (e.g. https://shipin-psi.vercel.app)
NEXT_PUBLIC_APP_URL=https://shipin-psi.vercel.app
# Server-side alias of the app URL. REQUIRED — it is the WebAuthn relying-party
# origin and joins the CORS allowlist, so an absent or relative value breaks
# admin sign-in rather than failing visibly.
APP_URL=https://shipin-psi.vercel.app

# --- Firebase (client SDK — safe to expose) ---
NEXT_PUBLIC_FIREBASE_API_KEY=
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=
NEXT_PUBLIC_FIREBASE_PROJECT_ID=
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=
NEXT_PUBLIC_FIREBASE_APP_ID=
# App Check reCAPTCHA Enterprise site key (public — Firebase Console → App Check →
# Apps → reCAPTCHA Enterprise). Leave blank to disable App Check locally; with
# enforcement on and no key, Auth fails with
# auth/firebase-app-check-token-is-invalid.
NEXT_PUBLIC_FIREBASE_APP_CHECK_SITE_KEY=
# "true" registers a local App Check debug token instead of calling reCAPTCHA.
NEXT_PUBLIC_FIREBASE_APP_CHECK_DEBUG=
# Require a valid App Check token on authenticated API routes too ("true").
APP_CHECK_ENFORCEMENT=false

# --- MFA session revocation (the admin denylist) ---
# The denylist fails CLOSED: if Upstash is unreachable, an already-issued elevation
# session cannot be proven unrevoked, so every admin request is rejected. That is the
# safe answer and, during an outage, a total admin lockout.
#
# Set MFA_DENYLIST_DEGRADED_MODE=open to add a circuit breaker: after 3 consecutive read
# failures, checks fail open for MFA_DENYLIST_DEGRADED_SECONDS (default 300, clamped
# 30..3600), with one critical alert and a visible `degraded` state on /api/health.
# The cost is real: while it is open, a session revoked during the outage still works.
# Leave both unset unless you have decided that availability wins for that window.
MFA_DENYLIST_DEGRADED_MODE=
MFA_DENYLIST_DEGRADED_SECONDS=

# --- Wallet credit rail ---
# Largest single credit an administrator may add by hand (POST /api/admin/wallet/credit),
# in credits rather than minor units. Defaults to 10000 when unset. A credit is money
# created manually, so the rail exists to catch a typo (1000000 instead of 100000);
# an unusable value falls back to the default rather than removing the limit, and
# anything above 1,000,000 is clamped to it.
WALLET_CREDIT_MAX=

# --- Firebase Admin (server-only secret) — REQUIRED ---
FIREBASE_ADMIN_PROJECT_ID=
FIREBASE_ADMIN_CLIENT_EMAIL=
# JSON service-account private key. Keep \n as literal backslash-n in this file.
FIREBASE_ADMIN_PRIVATE_KEY=

# --- PayPal — the two server credentials below are REQUIRED ---
NEXT_PUBLIC_PAYPAL_CLIENT_ID=
PAYPAL_CLIENT_ID=
PAYPAL_CLIENT_SECRET=
# sandbox | live
PAYPAL_ENV=sandbox
# PayPal Webhook ID for signature verification.
# REQUIRED in production — missing this will cause the server to fail at startup.
# Leave empty in dev/test only; webhook verification is skipped.
PAYPAL_WEBHOOK_ID=
PAYPAL_API_URL=https://api-m.sandbox.paypal.com

# --- Email — REQUIRED (at least one channel must be usable in production) ---
# Resend (primary)
RESEND_API_KEY=
# SMTP (fallback)
SMTP_EMAIL=
SMTP_PASSWORD=
# Optional: use a specific SMTP relay instead of Gmail. Leave SMTP_HOST empty
# to keep the Gmail service shortcut.
SMTP_HOST=
SMTP_PORT=
SMTP_SECURE=
SMTP_SERVICE=

# --- File Storage — Cloudflare R2 — REQUIRED ---
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET_NAME=
# Optional: defaults to "auto" (Cloudflare R2). Set both when moving to AWS S3
# or another S3-compatible store.
R2_REGION=
# Presigned-URL lifetime per purpose, in seconds (see src/lib/r2UrlPolicy.ts).
# Inspection photos default to 3600 so a warehouse review does not expire mid-pass;
# shipping labels default to 900. Ignored unless within 60..604800.
R2_INSPECTION_URL_TTL_SECONDS=
R2_LABEL_URL_TTL_SECONDS=

# Log aggregation (docker/vector/vector.toml, compose profile "observability").
# Leave LOKI_URL empty to ship to the local Loki container. For Grafana Cloud use
# https://logs-prod-<region>.grafana.net/loki/api/v1/push with the instance id as
# LOKI_USERNAME and an access-policy token as LOKI_PASSWORD.
LOKI_URL=
LOKI_USERNAME=
LOKI_PASSWORD=
R2_ENDPOINT=

# --- WhatsApp Business (optional) ---
WHATSAPP_ACCESS_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_API_VERSION=v25.0

# --- Admin MFA sessions — REQUIRED in every environment ---
# Signs the short-lived admin elevation cookie issued after a successful
# MFA check (POST /api/auth/mfa/session). Minimum 32 characters.
# There is no derived fallback: production refuses to boot without it, and the
# MFA session helper fails closed rather than signing with a guessable key.
MFA_SESSION_SECRET=
# Signs the permanent email-verification link (POST /api/auth/resend-verification).
# Minimum 32 characters. Optional: when unset the app falls back to
# MFA_SESSION_SECRET, which is already required, and only if that is unusable does it
# send Firebase's expiring link instead. Set this to give verification links their own
# key. Generate one with: node -e "console.log(require('crypto').randomBytes(32).toString('base64url'))"
EMAIL_VERIFICATION_SECRET=
# --- Alerting (REQUIRED in production) ---
# At least one webhook below must be set: production boot fails without one
# (validateProductionRequiredEnv). The failure it prevents is silence - an
# exhausted reCAPTCHA quota rejects every API call while /api/health only says
# `degraded`, which nothing watches. The only opt-out is
# ALERT_WEBHOOK_OPTIONAL=1, for the local E2E suite.
# Discord webhook that receives one message per App Check rejection spike
# (reCAPTCHA quota exhaustion). Falls back to BREACH_ALERT_WEBHOOK_URL, and when
# neither is set the alert is a no-op: /api/health still reports `degraded`.
APP_CHECK_ALERT_WEBHOOK_URL=
# Discord webhook for tracked server errors: payment drift, settlement
# failures, MFA revocation-store outages and cron failures. Each is deduplicated
# by fingerprint, so one incident pages once per ten minutes rather than once per
# occurrence. Falls back to ALERT_WEBHOOK_URL, then BREACH_ALERT_WEBHOOK_URL;
# unset means errors are counted and published by /api/health only.
ERROR_ALERT_WEBHOOK_URL=
# Set to exactly 1 to boot production with no alert webhook at all (E2E only).
ALERT_WEBHOOK_OPTIONAL=
# Slack/incident webhook for critical data breaches
BREACH_ALERT_WEBHOOK_URL=

# --- Rate Limiting — Upstash Redis (REQUIRED in production) ---
# In-memory rate limiting only works per-instance on Vercel, so an attacker
# can bypass limits by spreading requests across serverless regions.
# Production refuses to boot without both values (validateProductionRequiredEnv);
# the only opt-out is RATE_LIMIT_STORE_OPTIONAL=1, which exists for the local
# E2E suite. That suite also sets RATE_LIMIT_DISABLED=1, which switches the
# limiter off for the run: thousands of requests from one IP against a
# 100/minute budget cannot pass otherwise. It is honoured in development, and
# in a production build only when RATE_LIMIT_STORE_OPTIONAL=1 is set too, so a
# stray variable can never disable limits on a real deployment. In development
# the limiter falls back to memory and /api/health reports the store as
# `degraded`.
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=
# Extra frontend origins allowed by CORS (comma-separated). Optional.
# The deployment origin itself comes from APP_URL, and the current Vercel
# preview host from VERCEL_URL / VERCEL_BRANCH_URL, so preview builds can sign
# in without being listed here.
APP_ALLOWED_ORIGINS=

# --- Money representation (ADR-0008) ---
# Every wallet writer stores both `balance` and `balanceMinor`. Setting
# MONEY_MINOR_ONLY=1 stops the decimal fields being written, leaving integer
# minor units as the only stored representation. Do not set it until the backfill
# (`npm run migrate -- 003-money-minor-units`) has been *applied* against the
# project and a dry run reports 0 mismatch(es) and 0 unreadable, and every reader
# is on `storedMinor` — docs/OPERATIONS.md lists all four conditions, and each one
# is a way for the flag to turn a balance into zero rather than into a wrong
# number. Readers accept both shapes in either mode, so this flag only changes
# what is written.
# MONEY_MINOR_ONLY=1

# --- Cron ---
# Shared secret for /api/admin/requests/quotes/expire. The endpoint accepts
# ONLY a timestamp + HMAC signature (x-cron-timestamp / x-cron-signature);
# there is no bearer-token path. Without it that route answers
# 500 CONFIG_ERROR and the scheduled GitHub Action fails.
CRON_SECRET=

# --- India Post (CEPT) tracking ---
# Optional. Leave all three empty to serve the placeholder tracking feed shown
# on /track. Set them once CEPT whitelists the Azure proxy IP and sends UAT
# credentials; no code changes are needed.
INDIA_POST_TRACKING_URL=
INDIA_POST_CLIENT_ID=
INDIA_POST_CLIENT_SECRET=

# Set to 1 only when a reverse proxy is the sole path to this app and it
# sanitises x-forwarded-for / x-real-ip. With neither this nor VERCEL=1 (which
# Vercel sets itself), forwarded headers are ignored and every client shares
# one rate-limit bucket.
TRUST_PROXY=
