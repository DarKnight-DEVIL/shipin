NODE_ENV=development
# =============================================================================
# ShipIN — Environment Template
#
# Copy this file to `.env.local` and fill in real values:
#   cp .env.example .env.local
#
# Variables without a value are REQUIRED for the server to start.
# Client-exposed variables MUST be prefixed with NEXT_PUBLIC_.
# The app validates these at startup via src/config/env (fail-fast).
# =============================================================================

# --- Application ---
# Base URL used in emails / webhook callbacks (e.g. https://shipin-psi.vercel.app)
NEXT_PUBLIC_APP_URL=https://shipin-psi.vercel.app
# Server-side alias of the app URL (optional convenience for server code)
APP_URL=https://shipin-psi.vercel.app

# --- Firebase (client SDK — safe to expose) ---
NEXT_PUBLIC_FIREBASE_API_KEY=
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=
NEXT_PUBLIC_FIREBASE_PROJECT_ID=
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=
NEXT_PUBLIC_FIREBASE_APP_ID=

# --- Firebase Admin (server-only secret) ---
FIREBASE_ADMIN_PROJECT_ID=
FIREBASE_ADMIN_CLIENT_EMAIL=
# JSON service-account private key. Keep \n as literal backslash-n in this file.
FIREBASE_ADMIN_PRIVATE_KEY=

# --- PayPal ---
NEXT_PUBLIC_PAYPAL_CLIENT_ID=
PAYPAL_CLIENT_ID=
PAYPAL_CLIENT_SECRET=
# sandbox | live
PAYPAL_ENV=sandbox
# PayPal Webhook ID for signature verification.
# REQUIRED in production — missing this will cause the server to fail at startup.
# Leave empty in dev/test only; webhook verification is skipped.
PAYPAL_WEBHOOK_ID=
PAYPAL_API_URL=https://api-m.sandbox.paypal.com

# --- Email ---
# Resend (primary)
RESEND_API_KEY=
# SMTP (fallback)
SMTP_EMAIL=
SMTP_PASSWORD=

# --- File Storage — Cloudflare R2 ---
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET_NAME=

# --- WhatsApp Business (optional) ---
WHATSAPP_ACCESS_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_API_VERSION=v25.0

# --- Admin MFA sessions (optional) ---
# Signs the short-lived admin elevation cookie issued after a successful
# MFA check (POST /api/auth/mfa/session). Minimum 32 characters.
# If unset, a key is derived from FIREBASE_ADMIN_PRIVATE_KEY.
MFA_SESSION_SECRET=

# --- Rate Limiting — Upstash Redis (REQUIRED in production) ---
# In-memory rate limiting only works per-instance on Vercel, so an attacker
# can bypass limits by spreading requests across serverless regions.
# REQUIRED in production — the server will refuse to start without these.
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=
# Extra frontend origins allowed by CORS (comma-separated). Optional.
# Defaults already include the Vercel and Firebase Hosting domains.
APP_ALLOWED_ORIGINS=

# --- India Post (CEPT) tracking ---
# Optional. Leave all three empty to serve the placeholder tracking feed shown
# on /track. Set them once CEPT whitelists the Azure proxy IP and sends UAT
# credentials; no code changes are needed.
INDIA_POST_TRACKING_URL=
INDIA_POST_CLIENT_ID=
INDIA_POST_CLIENT_SECRET=
