{
  "$schema": "https://turbo.build/schema.json",
  "globalEnv": [
    "NODE_ENV",
    "LOG_LEVEL",
    "TRACKING_LOOKUP_CACHE_TTL_MS",
    "NEXT_PUBLIC_*",
    "APP_URL",
    "FIREBASE_ADMIN_*",
    "PAYPAL_*",
    "SMTP_*",
    "RESEND_API_KEY",
    "R2_*",
    "UPSTASH_*",
    "WHATSAPP_*",
    "MFA_SESSION_SECRET",
    "INDIA_POST_*",
    "CRON_SECRET",
    "BREACH_ALERT_WEBHOOK_URL",
    "ALERT_WEBHOOK_URL",
    "ERROR_ALERT_WEBHOOK_URL",
    "MONEY_MINOR_ONLY",
    "WALLET_SWEEP_BUDGET_MS",
    "ALLOW_UNVERIFIED_WEBHOOKS",
    "APP_ALLOWED_ORIGINS",
    "TRUST_PROXY",
    "UNSUBSCRIBE_SECRET",
    "EMAIL_VERIFICATION_SECRET",
    "TRACKING_TOKEN_SECRET",
    "MFA_DENYLIST_OPTIONAL",
    "MFA_DENYLIST_DEGRADED_MODE",
    "MFA_DENYLIST_DEGRADED_SECONDS",
    "WALLET_CREDIT_MAX",
    "NEXT_PHASE",
    "APP_CHECK_ENFORCEMENT",
    "RATE_LIMIT_STORE_OPTIONAL",
    "APP_CHECK_ALERT_WEBHOOK_URL"
  ],
  "globalDependencies": [".env*", "apps/*/.env*", "tsconfig.json"],
  "tasks": {
    "build": {
      "dependsOn": ["^build"],
      "outputs": [".next/**", "!*.next/cache/**", "dist/**"],
      "tags": ["ci"]
    },
    "dev": {
      "cache": false,
      "persistent": true
    },
    "lint": {
      "outputs": [],
      "tags": ["ci"]
    },
    "typecheck": {
      "outputs": [],
      "tags": ["ci"]
    },
    "test": {
      "outputs": ["coverage/**"],
      "tags": ["ci"]
    },
    "test:coverage": {
      "outputs": ["coverage/**"],
      "tags": ["ci"]
    },
    "check:bundle-budget": {
      "cache": false,
      "tags": ["ci"]
    }
  }
}
