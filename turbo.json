{
  "$schema": "https://turbo.build/schema.json",
  "globalEnv": [
    "NODE_ENV",
    "NEXT_PUBLIC_*",
    // Turbo runs tasks with a strict environment: only variables listed here
    // reach `next build`. Without these, the server env accessors see nothing
    // and page-data collection dies with "Missing required environment
    // variable: PAYPAL_CLIENT_SECRET" (exactly what CI hit).
    "APP_URL",
    "FIREBASE_ADMIN_*",
    "PAYPAL_*",
    "SMTP_*",
    "RESEND_API_KEY",
    "R2_*",
    "UPSTASH_*",
    "WHATSAPP_*",
    "MFA_SESSION_SECRET",
    "INDIA_POST_*",
    "SENTRY_*"
  ],
  "globalDependencies": ["**/.env", "**/.env.local", "tsconfig.json"],
  "tasks": {
    "build": {
      "dependsOn": ["^build"],
      "outputs": [".next/**", "!.next/cache/**", "dist/**"],
      "tags": ["ci"]
    },
    "dev": {
      "cache": false,
      "persistent": true
    },
    "lint": {
      "outputs": [],
      "tags": ["ci"]
    },
    "typecheck": {
      "outputs": [],
      "tags": ["ci"]
    },
    "test": {
      "outputs": ["coverage/**"],
      "tags": ["ci"]
    },
    "test:coverage": {
      "outputs": ["coverage/**"],
      "tags": ["ci"]
    },
    "check:bundle-budget": {
      "cache": false,
      "tags": ["ci"]
    }
  }
}
